            <input class="cb-input" type="text" name="search" value="@Model.SearchQuery" placeholder="Search tool name or description..." />
        </div>
        <div class="cb-filter-item">
            <label class="cb-label">Filter by Tool Type</label>
            <select class="cb-select" name="type">
