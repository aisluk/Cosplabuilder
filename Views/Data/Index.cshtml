    <div class="cb-pagination">
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <a class="cb-page-link @(p == Model.CurrentPage ? "cb-page-active" : "")"
               href="/tools?page=@p&pageSize=@Model.PageSize&search=@Model.SearchQuery&type=@Model.FilterType">
                Page @p
            </a>
        }
    </div>
}
else if (Model.ActiveView == "Materials")
{
    <div class="cb-breadcrumb">
        <a href="/">Home</a>
        <span class="cb-breadcrumb-sep">&rsaquo;</span>
        <span class="cb-breadcrumb-current">Materials Inventory</span>
    </div>

    <div class="cb-section-header">
        <h1 class="cb-section-title">Cosplay Materials (@Model.TotalItems)</h1>
        <div class="cb-hero-actions">
            @if (isAuth)
            {
                <button type="button" class="cb-btn cb-btn-primary cb-btn-sm" data-toggle-target="add-material-panel">+ Add Material</button>
            }
            <a class="cb-btn cb-btn-outline cb-btn-sm" href="/tools">&larr; Go to Tools</a>
        </div>
    </div>

    @if (isAuth)
    {
        <section id="add-material-panel" class="cb-panel cb-hidden">
            <h2 class="cb-panel-title">Add Cosplay Material</h2>
            <form method="post" action="/materials/form" enctype="multipart/form-data">
                <div class="cb-form-grid">
                    <div class="cb-form-group">
                        <label class="cb-label">Material Name *</label>
                        <input class="cb-input" type="text" name="name" maxlength="127" required />
                    </div>
                    <div class="cb-form-group">
                        <label class="cb-label">Material Type</label>
                        <select class="cb-select" name="materialType">
                            @foreach (var mt in Model.MaterialTypes)
                            {
                                <option value="@mt">@mt</option>
                            }
                        </select>
                    </div>
                    <div class="cb-form-group">
                        <label class="cb-label">Price</label>
                        <input class="cb-input" type="number" step="0.01" min="0" name="price" value="0.00" />
                    </div>
                    <div class="cb-form-group">
                        <label class="cb-label">Amount / Quantity</label>
                        <input class="cb-input" type="number" step="0.1" min="0" name="amount" value="1.0" />
                    </div>
                    <div class="cb-form-group">
                        <label class="cb-label">Source / Supplier</label>
                        <input class="cb-input" type="text" name="source" maxlength="255" placeholder="Local store, CosplayShop, etc." />
                    </div>
                    <div class="cb-form-group">
                        <label class="cb-label">Upload Photo</label>
                        <input class="cb-input" type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp,.gif,.svg" />
                    </div>
                    <div class="cb-form-group">
                        <label class="cb-label">Material Image Alt Text</label>
                        <input class="cb-input" type="text" name="imageAlt" maxlength="500" placeholder="Material swatch description" />
                    </div>
                </div>
                <div class="cb-form-group">
                    <label class="cb-label">Description</label>
                    <input class="cb-input" type="text" name="description" maxlength="500" placeholder="Density, color code, width, washing instructions..." />
                </div>
                <button type="submit" class="cb-btn cb-btn-primary">Save Material</button>
            </form>
        </section>
    }

    <form class="cb-filter-bar" method="get" action="/materials">
        <div class="cb-filter-item">
            <label class="cb-label">Search Materials</label>
            <input class="cb-input" type="text" name="search" value="@Model.SearchQuery" placeholder="Search material name, description, or source..." />
        </div>
        <div class="cb-filter-item">
            <label class="cb-label">Filter by Material Type</label>
            <select class="cb-select" name="type">
                <option value="">All Material Types</option>
                @foreach (var mt in Model.MaterialTypes)
                {
                    <option value="@mt" selected="@(mt == Model.FilterType)">@mt</option>
                }
            </select>
        </div>
        <div class="cb-filter-item">
            <label class="cb-label">Page Size</label>
            <select class="cb-select" name="pageSize">
                <option value="4" selected="@(Model.PageSize == 4)">4 per page</option>
                <option value="8" selected="@(Model.PageSize == 8)">8 per page</option>
                <option value="16" selected="@(Model.PageSize == 16)">16 per page</option>
            </select>
        </div>
        <div>
            <button type="submit" class="cb-btn cb-btn-primary">Filter Materials</button>
            <a class="cb-btn cb-btn-secondary" href="/materials">Reset</a>
        </div>
    </form>

    <div class="cb-card-grid">
        @foreach (var m in Model.Materials)
        {
            string? matImgUrl = ImageNameHasher.ResolveImageUrl(m.MaterialImage?.FilePath);

            <article class="cb-card">
                @if (!string.IsNullOrEmpty(matImgUrl))
                {
                    <img class="cb-card-img" src="@matImgUrl" alt="@(m.MaterialImage?.AltText ?? m.Name)" loading="lazy" />
                }
                else
                {
                    <div class="cb-card-placeholder">@m.MaterialType: @m.Name</div>
                }

                <div class="cb-card-body">
                    <div class="cb-card-meta">
                        <span class="cb-badge cb-badge-type">@m.MaterialType</span>
                        <span>Qty: @m.Amount</span>
                        <span>Price: @m.Price.ToString("0.00")</span>
                        @if (!string.IsNullOrEmpty(m.Source))
                        {
                            <span>Source: @m.Source</span>
                        }
                    </div>
                    <h2 class="cb-card-title">@m.Name</h2>
                    <p class="cb-card-desc">@(m.Description ?? "No description provided.")</p>

                    @if (isAuth)
                    {
                        <div id="edit-material-@m.Id" class="cb-hidden cb-mt-1">
                            <form method="post" action="/materials/form" enctype="multipart/form-data">
                                <input type="hidden" name="id" value="@m.Id" />
                                <div class="cb-form-group">
                                    <label class="cb-label">Name</label>
                                    <input class="cb-input" type="text" name="name" value="@m.Name" required />
                                </div>
                                <div class="cb-form-group">
                                    <label class="cb-label">Material Type</label>
                                    <select class="cb-select" name="materialType">
                                        @foreach (var mt in Model.MaterialTypes)
                                        {
                                            <option value="@mt" selected="@(mt == m.MaterialType)">@mt</option>
                                        }
                                    </select>
                                </div>
                                <div class="cb-form-group">
                                    <label class="cb-label">Price</label>
                                    <input class="cb-input" type="number" step="0.01" min="0" name="price" value="@m.Price" />
                                </div>
                                <div class="cb-form-group">
                                    <label class="cb-label">Amount</label>
                                    <input class="cb-input" type="number" step="0.1" min="0" name="amount" value="@m.Amount" />
                                </div>
                                <div class="cb-form-group">
                                    <label class="cb-label">Source</label>
                                    <input class="cb-input" type="text" name="source" value="@m.Source" maxlength="255" />
                                </div>
                                <div class="cb-form-group">
                                    <label class="cb-label">Description</label>
                                    <input class="cb-input" type="text" name="description" value="@m.Description" maxlength="500" />
                                </div>
                                <div class="cb-form-group">
                                    <label class="cb-label">Upload New Material Swatch Image</label>
                                    <input class="cb-input" type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp,.gif,.svg" />
                                </div>
                                <div class="cb-form-group">
                                    <label class="cb-label">Image Alt Text</label>
                                    <input class="cb-input" type="text" name="imageAlt" value="@m.MaterialImage?.AltText" maxlength="500" />
                                </div>
                                <button type="submit" class="cb-btn cb-btn-primary cb-btn-sm">Update Material</button>
                            </form>
                        </div>
                    }
                </div>

                <div class="cb-card-footer">
                    @if (isAuth)
                    {
                        <button type="button" class="cb-btn cb-btn-secondary cb-btn-sm" data-toggle-target="edit-material-@m.Id">Edit / Image</button>
                    }
                    @if (isAdmin)
                    {
                        <a class="cb-btn cb-btn-outline cb-btn-sm" href="/api/materials/@m.Id" target="_blank">REST: GET</a>
                    }
                    @if (isAuth)
                    {
                        <button type="button" class="cb-btn cb-btn-danger cb-btn-sm" data-rest-delete="/api/materials/@m.Id">Delete</button>
                    }
                </div>
            </article>
        }
    </div>

    <div class="cb-pagination">
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <a class="cb-page-link @(p == Model.CurrentPage ? "cb-page-active" : "")"
               href="/materials?page=@p&pageSize=@Model.PageSize&search=@Model.SearchQuery&type=@Model.FilterType">
                Page @p
            </a>
        }
    </div>
}
