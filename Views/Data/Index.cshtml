                </div>

                <div class="cb-card-footer">
                    @if (canManageTool)
                    {
                        <button type="button" class="cb-btn cb-btn-secondary cb-btn-sm" data-toggle-target="edit-tool-@tl.Id">Edit / Image</button>
                    }
                    @if (isAdmin)
                    {
                        <a class="cb-btn cb-btn-outline cb-btn-sm" href="/api/tools/@tl.Id" target="_blank">REST: GET</a>
                    }
                    @if (canManageTool)
                    {
                        <button type="button" class="cb-btn cb-btn-danger cb-btn-sm" data-rest-delete="/api/tools/@tl.Id">Delete</button>
                    }
